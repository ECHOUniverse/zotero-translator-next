{
  "name": "zotero-translator-next",
  "type": "module",
  "version": "0.2.5",
  "description": "Zotero 文献翻译插件：格式优化 + 多渠道翻译 + 翻译历史 + AI 总结",
  "config": {
    "addonName": "ZoteroTranslatorNext",
    "addonID": "zotero-translator-next@echouniverse.io",
    "addonRef": "zotero-translator-next",
    "addonInstance": "ZoteroTranslatorNext",
    "prefsPrefix": "extensions.zotero.zotero-translator-next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ECHOUniverse/zotero-translator-next.git"
  },
  "author": "ECHOUniverse",
  "bugs": {
    "url": "https://github.com/ECHOUniverse/zotero-translator-next/issues"
  },
  "homepage": "https://github.com/ECHOUniverse/zotero-translator-next#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "icons:export": "node scripts/icon-gen.mjs --all",
    "update-deps": "npm update --save",
    "test:unit": "mocha --require tsx 'test/unit/**/*.test.ts'"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "es5-ext": true,
    "esbuild": true
  }
}

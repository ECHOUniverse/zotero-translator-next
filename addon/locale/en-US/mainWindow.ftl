# Main window strings (section header/sidenav data-l10n-id resolves here)
# Note: collapsible-section label is an attribute, so messages must use the
# .label form (a plain value would be written into textContent, wiping the section content!)

ztr-section-reader-header =
    .label = Translate
ztr-section-item-header =
    .label = Translate

# Multi-region selection (multi-select segment translation)

ztr-add-to-selection = Add to selection
ztr-added-to-selection = ✓ Added ({ $count })
ztr-already-in-selection = Already in selection
ztr-selection-limit = Limit reached (50)
ztr-selection-translate-all = Translate all
ztr-selection-clear = Clear
ztr-selection-clear-confirm = Clear multi-region selection for this item?
ztr-section-selection-header =
    .label = Multi-region selection
ztr-selection-delete = Remove region

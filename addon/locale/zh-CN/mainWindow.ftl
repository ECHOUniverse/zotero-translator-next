# 主窗口字符串（区块 header/sidenav 的 data-l10n-id 在此解析）
# 注意：collapsible-section 的 label 是属性，message 必须用 .label 形态
# （纯 value 形态会被 Fluent 写入 textContent，清空区块内容！）

ztr-section-reader-header =
    .label = 翻译
ztr-section-item-header =
    .label = 翻译

# 跨区域选区（多选拼段翻译）

ztr-add-to-selection = 加入选区
ztr-added-to-selection = ✓ 已加入({ $count }段)
ztr-already-in-selection = 已在选区中
ztr-selection-limit = 已达上限(50段)
ztr-selection-translate-all = 翻译全部
ztr-selection-clear = 清空
ztr-selection-clear-confirm = 清空当前文献的跨区域选区？
ztr-section-selection-header =
    .label = 跨区域选区
ztr-selection-delete = 移除此区域
